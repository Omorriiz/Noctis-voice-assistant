# ESP32-S3 DevKitC-1 N16R8: 16 MB flash (QIO), 8 MB octal PSRAM
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

# Производительность для esp-sr (как в примерах Espressif)
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
CONFIG_FREERTOS_HZ=1000

# Таблица разделов с разделом "model" для моделей esp-sr
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# esp-sr: только «Привет ESP», без распознавания команд (MultiNet)
CONFIG_MODEL_IN_FLASH=y
CONFIG_SR_WN_WN10_RU_PRIVETESP=y
CONFIG_SR_MN_CN_NONE=y
CONFIG_SR_MN_EN_NONE=y

# --- Этап 2: BLE-сопряжение (NimBLE), OTA с откатом ---
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_ESP_HTTP_CLIENT_ENABLE_HTTPS=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y

# --- Этап 4: готовые слова esp-sr (переключаются без перепрошивки приложения; «Привет ESP» уже включён выше) ---
CONFIG_SR_WN_WN10_HIESP=y
CONFIG_SR_WN_WN10_DE_HALLOESP=y
CONFIG_SR_WN_WN10_ES_HOLAESP=y
CONFIG_SR_WN_WN10_FR_BONJOURESP=y
CONFIG_SR_WN_WN10_ALEXA=y
CONFIG_SR_WN_WN9_JARVIS_TTS=y
CONFIG_SR_WN_WN9_COMPUTER_TTS=y

# Стек main_task: инициализация (NVS, esp-sr, расписание) на 3,5 КБ переполнялась
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# Стек системного event-loop: обработчик got_ip запускает WebSocket прямо в этой задаче; 2,3 КБ переполнялись
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=6144

# Стек задачи таймеров FreeRTOS (по умолчанию 2 КБ)
CONFIG_FREERTOS_TIMER_TASK_STACK_DEPTH=4096

# Выделения больше 4 КБ — во внешнюю PSRAM, чтобы не съедать внутреннюю память (её не хватало Wi-Fi: «обрыв по beacon timeout»)
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096

# Внутренней памяти мало (Wi-Fi не выдерживала: обрывы «beacon timeout»): меньше буферов Wi-Fi, без размещения кода Wi-Fi в IRAM
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16
CONFIG_ESP_WIFI_TX_BA_WIN=4
CONFIG_ESP_WIFI_RX_BA_WIN=4
CONFIG_ESP_WIFI_MGMT_SBUF_NUM=16
# CONFIG_ESP_WIFI_IRAM_OPT is not set
# CONFIG_ESP_WIFI_RX_IRAM_OPT is not set
