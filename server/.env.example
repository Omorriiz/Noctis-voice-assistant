# Copy to .env and edit. All values have safe development defaults.
NOCTIS_ENV=development                 # development | production
NOCTIS_DATABASE_URL=sqlite:///./data/noctis.db
# Проект использует SQLite (один файл, без отдельного сервера БД).
# NOCTIS_SECRET_KEY=              # не задавайте: случайный ключ создаётся при первом запуске (data/secret.key). Свой — не короче 32 символов
NOCTIS_CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]
NOCTIS_ALLOW_ANONYMOUS_DEVICES=false   # true только для очень старой прошивки без токена устройства
NOCTIS_STORE_AUDIO=false               # keep incoming WAV files for debugging (privacy!)
NOCTIS_WHISPER_MODEL_DIR=./models/faster-whisper-large-v3
NOCTIS_OLLAMA_MODEL=OxW/Vikhr-Nemo-12B-Instruct-R-21-09-24:q4_K_M

# --- Этап 5: музыка (источники: своя библиотека, Jamendo, интернет-радио; других нет) ---
NOCTIS_MUSIC_DIR=./data/music          # <папка>/<id пользователя>/*.mp3|flac|ogg|wav (или загрузка через приложение/API)
NOCTIS_MUSIC_UPLOAD_MAX_MB=60
NOCTIS_JAMENDO_CLIENT_ID=              # свой client_id с developer.jamendo.com; пусто — Jamendo выключен
NOCTIS_RADIO_STATIONS_FILE=./data/radio_stations.json   # необязательно: [{"name": "...", "url": "http://.../stream"}]
NOCTIS_SCHEDULER_ENABLED=true          # цикл таймеров и будильников
NOCTIS_TEST_CONSOLE=true          # страница /console для проверки колонки; в продакшне false
NOCTIS_WHISPER_COMPUTE=int8_float16   # float16 быстрее, но занимает ~3 ГБ видеопамяти
